<Window x:Class="DisainWindow.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="400" Width="300" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Фамилия:"/>
            <TextBox x:Name="txtLastName" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="Имя:"/>
            <TextBox x:Name="txtFirstName" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="Логин:"/>
            <TextBox x:Name="txtRegLogin" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="txtRegPassword" Margin="0,0,0,20" Padding="5"/>

            <Button Content="Зарегистрироваться" Click="btnRegister_Click" Height="35" />
        </StackPanel>
    </Grid>
</Window>