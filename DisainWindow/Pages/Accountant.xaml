<Page x:Class="DisainWindow.Pages.Accountant"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Кабинет бухгалтера">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Счета от лечебных учреждений" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Таблица со счетами -->
        <DataGrid x:Name="dgInvoices" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" 
                  SelectionMode="Single" SelectionUnit="FullRow" Margin="0,0,0,10"/>

        <!-- Кнопка оплаты -->
        <Button x:Name="btnPay" Grid.Row="2" Content="Оплатить выбранный счет" 
                Click="btnPay_Click" Height="40" Background="#0078D7" Foreground="White" 
                FontWeight="Bold" FontSize="14" Margin="0,5,0,5" HorizontalAlignment="Center" Width="217"/>
    </Grid>
</Page>