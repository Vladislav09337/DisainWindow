<Page x:Class="DisainWindow.Pages.Auto"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DisainWindow.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Auto">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="260">
            <TextBlock Text="Логин:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtblLogin" Padding="5" Margin="0,0,0,10"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="pswbPassword" Padding="5" Margin="0,0,0,10"/>

            <!-- Скрытые элементы для капчи (оставил как было) -->
            <TextBlock Visibility="Hidden" x:Name="txtBlockCaptcha" Text="Капча:"/>
            <TextBox Visibility="Hidden" x:Name="txtboxCaptcha"/>
            <TextBlock HorizontalAlignment="Center" Visibility="Hidden" x:Name="txtBlockTimer"/>

            <!-- Блок с кнопками -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button x:Name="btnEnterGuests" Content="Войти как гость" Click="btnEnterGuests_Click" Margin="5" Padding="10,5" Width="142"/>
                <Button x:Name="btnEnter" Content="Войти" Click="btnEnter_Click" Margin="5" Padding="10,5"/>
            </StackPanel>


            <Button Content="Регистрация" Click="btnGoToRegister_Click" Margin="0,10,0,10" Height="30" Background="LightGray" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Page>
